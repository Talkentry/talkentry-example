# =============================================================================
# Talkentry Server — local development
# =============================================================================
# API: 3087
# Postgres: 35432
# =============================================================================

NODE_ENV=development
PORT=3087

# CORS for local SDK / example clients
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# --- Database (direct Postgres, no PgBouncer) ---
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=35432
DB_NAME=talkentra_db
DB_USERNAME=postgres
DB_PASSWORD=example
DB_SCHEMA=talkentra
DB_POOL_MAX=10
